{
  "layer": "top",
  "margin": "4px 1px 0px 1px",
  "reload_style_on_change": true,
  "fixed-center": true,

  // --- ESTRUCTURA DE LA BARRA ---
  "modules-left": [
    "clock",
    "cpu",
    "memory"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "network",
    "battery",
    "tray",
    "custom/power"
  ],

  // --- MÓDULOS IZQUIERDA ---
  "clock": {
    "format": "{:%b %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 1,
    "format": "  {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 30,
    "format": "   {used:0.1f}G",
    "max-length": 10
  },

  // --- MÓDULOS CENTRO ---
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": 5
    }
  },

  // --- MÓDULOS DERECHA ---
  "network": {
    "interval": 1,
    "on-click": "nm-connection-editor",
    "format-wifi": "{essid} {icon}",
    "format-ethernet": "{ifname} ",
    "format-disconnected": "Desconectado ",
    "format-icons": [
      "󰤟", // 0-25%
      "󰤢", // 26-50%
      "󰤥", // 51-75%
      "󰤨"  // 76-100%
    ]
  },
  "battery": {
    "format": "{icon}   {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "tray": {
    "spacing": 6,
    "icon-size": 18
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "sh -c 'wlogout $WLOGOUT_FLAGS'"
  }
}
