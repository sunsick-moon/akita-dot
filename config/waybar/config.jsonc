{
  "layer": "top",
  "margin": "2px 2px 0px 2px",
  "reload_style_on_change": true,
  "fixed-center": true,

  // --- ESTRUCTURA DE LA BARRA ---
  "modules-left": [
    "clock",
    "cpu",
    "memory",
    "custom/scroll-windows-indicator"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "network",
    "battery",
    "custom/tuned",
    "custom/powermenu"
  ],

  // --- MÓDULOS IZQUIERDA ---
  "clock": {
    "format": "{:%b %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 10,
    "format": "  {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 30,
    "format": "   {used:0.1f}G",
    "max-length": 10
  },

  // --- MÓDULOS CENTRO ---
  "hyprland/workspaces": {
      "persistent-workspaces": {
          "*": [1, 2, 3, 4, 5]
      },
      "sort-by": "number"
  },

  // --- MÓDULOS DERECHA ---
  "custom/scroll-windows-indicator": {
      "exec": "~/.config/scripts/getWindows.sh",
      "return-type": "string",
      "format": "{}",
      "interval": 1
  },
  "network": {
    "interval": 1,
    "on-click": "kitty --class nmtui-popup fish -c \"NEWT_COLORS=(string join ' ' (cat ~/.config/nmtui/palette)) nmtui\"",
    "format-wifi": "{essid} {icon}",
    "format-ethernet": "{ifname} ",
    "format-disconnected": "Desconectado ",
    "format-icons": [
      "󰤟", // 0-25%
      "󰤢", // 26-50%
      "󰤥", // 51-75%
      "󰤨"  // 76-100%
    ]
  },
  "battery": {
    "format": "{icon}   {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "tray": {
    "spacing": 6,
    "icon-size": 18
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "sh -c 'wlogout $WLOGOUT_FLAGS'"
  },
  "custom/tuned": {
      "format": "{}",
      "exec": "~/.config/scripts/tuned_status.sh",
      "interval": 3,
      "on-click": "~/.config/scripts/tuned_toggle.sh",
      "tooltip": true,
      "tooltip-format": "Clic para cambiar perfil de TuneD stock"
  },
  "custom/powermenu": {
      "format": "{}",
      "return-type": "json",
      "interval": "once",
      "exec": "~/.config/scripts/power_toggle.sh",
      "on-click": "~/.config/scripts/power_toggle.sh exec",
      "on-scroll-up": "~/.config/scripts/power_toggle.sh prev",
      "on-scroll-down": "~/.config/scripts/power_toggle.sh next",
      "signal": 8
  }
}
